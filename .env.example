APP_NAME="WFM Duty Matrix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Europe/Kyiv
APP_LOCALE=uk
SCHEDULE_TIME_UNIT=days

LOG_CHANNEL=stack
