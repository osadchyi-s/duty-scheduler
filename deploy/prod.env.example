# Production environment. Copy to deploy/prod.env and fill in the secrets:
#   cp deploy/prod.env.example deploy/prod.env
# The real env files are not committed (see .gitignore).

# Published port of the web container: http://<server-ip>:APP_PORT
APP_PORT=8080

APP_NAME="WFM Duty Matrix"
APP_ENV=production
# Generate once and keep it: deploy/deploy.sh key
APP_KEY=
APP_DEBUG=false
APP_URL=http://10.0.0.5:8080
APP_TIMEZONE=Europe/Kyiv
APP_LOCALE=uk
SCHEDULE_TIME_UNIT=days

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wfm
DB_USERNAME=wfm
DB_PASSWORD=change-me

# Production and staging share the server IP, and browsers do not separate
# cookies by port, so each environment needs its own session cookie name.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_COOKIE=wfm_prod_session
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Optional memory limits of the containers.
WFM_APP_MEM_LIMIT=1g
WFM_WORKER_MEM_LIMIT=512m
WFM_DB_MEM_LIMIT=1g
